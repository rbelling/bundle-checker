{
  "author": "Riccardo Bellingeri",
  "bin": {
    "bundle-checker": "./bin/run"
  },
  "bugs": {
    "url": "https://github.com/rbelling/bundle-checker/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "18.20.4"
  },
  "dependencies": {
    "@oclif/command": "^1",
    "@oclif/config": "^1",
    "@oclif/plugin-help": "^2",
    "@octokit/rest": "16.23.4",
    "bytes": "^3.1.0",
    "globby": "^9.2.0",
    "ora": "^3.3.0",
    "ramda": "0.26.1",
    "size-limit": "1.0.1",
    "tslib": "^1"
  },
  "description": "CLI tool to generate stats on the size of files between two git branches",
  "devDependencies": {
    "@oclif/dev-cli": "^1",
    "@oclif/test": "^1",
    "@oclif/tslint": "^3",
    "@types/bytes": "^3.0.0",
    "@types/jest": "^29.5.12",
    "@types/ramda": "0.26.1",
    "husky": "^1.3.1",
    "jest": "^29.7.0",
    "lint-staged": "^8.1.5",
    "prettier": "^1.16.4",
    "ts-jest": "^29.2.4",
    "tslint": "^5.15.0",
    "tslint-config-prettier": "^1.18.0",
    "tslint-plugin-prettier": "^2.0.1",
    "typescript": "^5.5.4"
  },
  "homepage": "https://github.com/rbelling/bundle-checker#readme",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "oclif": {
    "bin": "bundle-checker",
    "commands": "./build/commands",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "files": [
    "/bin",
    "/build",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "bundle size",
    "CI/CD",
    "code review",
    "performance monitoring",
    "TypeScript"
  ],
  "license": "ISC",
  "lint-staged": {
    "*.ts": [
      "tslint --fix",
      "git add"
    ]
  },
  "main": "index.js",
  "name": "bundle-checker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbelling/bundle-checker.git"
  },
  "scripts": {
    "build": "rm -rf ./build/* && tsc -p ./tsconfig.prod.json",
    "lint": "tslint src/**/*.ts",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif-dev manifest && oclif-dev readme",
    "test": "tsc --noEmit && jest"
  },
  "version": "1.5.0"
}
