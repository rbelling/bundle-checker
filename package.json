{
  "author": "Riccardo Bellingeri",
  "bin": {
    "bundle-checker": "./bin/run.js"
  },
  "bugs": {
    "url": "https://github.com/rbelling/bundle-checker/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "18.20.4"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "@octokit/rest": "16.23.4",
    "bytes": "^3.1.0",
    "globby": "^9.2.0",
    "oclif": "^4",
    "ora": "^3.3.0",
    "ramda": "0.26.1",
    "size-limit": "1.0.1"
  },
  "description": "CLI tool to generate stats on the size of files between two git branches",
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/bytes": "^3.0.0",
    "@types/jest": "^29.5.12",
    "@types/ramda": "0.26.1",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "eslint": "^8",
    "eslint-config-oclif": "^5",
    "eslint-config-oclif-typescript": "^3",
    "eslint-config-prettier": "^9",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.8",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "type-fest": "^4.24.0",
    "typescript": "^5.5.4"
  },
  "homepage": "https://github.com/rbelling/bundle-checker#readme",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "oclif": {
    "bin": "bundle-checker",
    "commands": "./build/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ]
  },
  "files": [
    "/bin",
    "/build",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "bundle size",
    "CI/CD",
    "code review",
    "performance monitoring",
    "TypeScript"
  ],
  "license": "ISC",
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write --cache"
    ],
    "*.{ts,mjs}": [
      "eslint --fix --cache",
      "prettier --write --cache"
    ]
  },
  "main": "index.js",
  "name": "bundle-checker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbelling/bundle-checker.git"
  },
  "scripts": {
    "build": "rm -rf ./build/* && tsc -p ./tsconfig.prod.json",
    "lint": "eslint ./",
    "format": "prettier . --loglevel='silent' -w . && npm run lint -- --fix",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "tsc --noEmit && jest",
    "prepare": "husky"
  },
  "version": "1.5.0"
}
